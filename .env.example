# ============================================================
# DisciNet — Environment Variables
# Copy this file to .env.local for local development.
# Add these exact keys in Vercel → Settings → Environment Variables.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Notes ────────────────────────────────────────────────────
# • VITE_SUPABASE_URL      — your project's REST + Edge Function base URL
# • VITE_SUPABASE_ANON_KEY — safe to expose in the browser (row-level security
#                            enforces access control server-side)
# • All Supabase Edge Functions (LLM, manage-users, send-invite-email, etc.)
#   are called via: ${VITE_SUPABASE_URL}/functions/v1/<function-name>
#   using the anon key as the Bearer token — no extra API keys needed client-side.
# ============================================================
